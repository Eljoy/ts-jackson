{
  "name": "ts-jackson",
  "version": "2.0.0",
  "author": "Ilias Gazdaliev",
  "description": "TypeScript library for serializing and deserializing JSON into classes using decorators and lodash path patterns",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.mjs",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c",
    "postbuild": "npm run tsc-release",
    "tsc-release": "tsc -p ts-config.release.json",
    "lint": "eslint src index.ts",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "watch": "tsc --watch",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eljoy/ts-jackson.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Eljoy/ts-jackson/issues"
  },
  "keywords": [
    "json",
    "typescript",
    "serializer",
    "deserializer",
    "decorator",
    "metadata",
    "serialize",
    "deserialize",
    "json serialize",
    "json deserialize",
    "DTO",
    "Data Transfer Objects",
    "Jackson",
    "Object mapper",
    "json-mapper",
    "json-adapter",
    "json-transformer",
    "typescript-json",
    "api-adapter",
    "api-mapper"
  ],
  "homepage": "https://github.com/Eljoy/ts-jackson#readme",
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "reflect-metadata": ">=0.1.13 <0.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.3",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
