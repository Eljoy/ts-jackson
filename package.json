{
  "name": "ts-jackson",
  "version": "2.0.1",
  "author": "Ilias Gazdaliev",
  "description": "Serialize and deserialize deeply nested JSON into TypeScript classes with decorators. Deep lodash-style path mapping, TC39 standard decorator support, strict type checking, zod-style safe parsing, polymorphism, Maps and naming strategies.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.mjs",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c",
    "postbuild": "npm run tsc-release",
    "tsc-release": "tsc -p ts-config.release.json",
    "lint": "eslint src index.ts",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "watch": "tsc --watch",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eljoy/ts-jackson.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Eljoy/ts-jackson/issues"
  },
  "keywords": [
    "json",
    "typescript",
    "serializer",
    "deserializer",
    "serialization",
    "deserialization",
    "decorators",
    "decorator",
    "jackson",
    "json-mapper",
    "object-mapper",
    "json-to-class",
    "json-parser",
    "safe-parse",
    "type-safe",
    "strict",
    "validation",
    "polymorphism",
    "naming-strategy",
    "snake-case",
    "camel-case",
    "nested-json",
    "json-path",
    "dto",
    "data-transfer-object",
    "api-adapter",
    "api-mapper",
    "json-transformer",
    "typescript-json",
    "reflect-metadata",
    "marshalling",
    "unmarshalling"
  ],
  "homepage": "https://github.com/Eljoy/ts-jackson#readme",
  "dependencies": {
    "lodash": "^4.17.21",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "reflect-metadata": ">=0.1.13 <0.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "js-yaml": "^5.4.1"
  }
}
