{
  "compilerOptions": {
    "target": "ES2017",
    "outDir": "./dist",
    "strictFunctionTypes": false,
    "lib": [
      "ES2017"
    ],
    "sourceMap": true,
    "types": ["jest", "node"],
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "removeComments": false,
    "strict": false,
    "noImplicitAny": false
  },
  "exclude": ["./node_modules/*", "./dist/**/*"]
}
